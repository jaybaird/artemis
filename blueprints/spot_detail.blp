using Gtk 4.0;
using Adw 1;

template $SpotDetail : Box {
  orientation: vertical;

  Adw.HeaderBar detail_header {
    show-title: false;
    show-start-title-buttons: false;
    show-end-title-buttons: false;
    styles ["flat"]
  }

  Stack detail_stack {
    vexpand: true;
    hexpand: true;

    StackPage {
      name: "empty";
      child: Adw.StatusPage {
        vexpand: true;
        icon-name: "bullseye-symbolic";
        title: _("No Spot Selected");
        description: _("Select a spot from the list to view its details.");
      };
    }

    StackPage {
      name: "detail";
      child: ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;

          Adw.Clamp {
            maximum-size: 360;
            tightening-threshold: 320;

            Box {
              orientation: vertical;
              spacing: 24;
              margin-top: 12;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;

            Box {
              orientation: vertical;
              spacing: 8;

              Adw.Avatar detail_avatar {
                size: 72;
                halign: center;
                text: _("");
              }

              Label detail_callsign {
                halign: center;
                ellipsize: end;
                max-width-chars: 24;
                styles ["title-1"]
              }

              Label detail_park_name {
                halign: center;
                wrap: true;
                wrap-mode: word_char;
                justify: center;
                styles ["title-2"]
              }

              Box detail_context_card {
                orientation: horizontal;
                halign: fill;
                hexpand: true;
                margin-top: 12;
                styles ["card", "weather-summary-card"]

                Box {
                  orientation: horizontal;
                  spacing: 4;
                  halign: fill;
                  hexpand: true;

                  Stack weather_stack {
                    transition-type: crossfade;
                    transition-duration: 250;
                    hexpand: true;

                    Box weather_unavailable_card {
                      spacing: 4;
                      halign: center;

                      Image {
                        icon-name: "cloud-disabled-symbolic";
                        width-request: 24;
                        height-request: 24;

                        accessibility {
                          label: _("Weather unavailable");
                        }
                      }

                      Label {
                        label: _("Weather unavailable");
                      }
                    }

                    Box weather_loading_card {
                      spacing: 4;
                      halign: center;

                      Adw.Spinner {
                        width-request: 24;
                        height-request: 24;
                      }

                      Label {
                        label: _("Loading weather…");
                      }
                    }

                    Box weather_summary_card {
                      halign: center;
                      orientation: horizontal;
                      spacing: 4;

                    Image wx_conditions {
                      icon-name: "storm-outline-symbolic";
                      valign: baseline;
                      styles ["weather-summary-icon"]
                      accessibility {
                        label: _("Weather Conditions");
                        role-description: _("icon");
                      }
                    }

                    Label wx_conditions_txt {
                      label: _("Thunderstorms");
                      ellipsize: end;
                      max-width-chars: 18;
                    }

                    Separator {
                      orientation: vertical;
                      styles ["spot-badge-separator"]
                    }

                    Image {
                      icon-name: "thermometer-symbolic";
                      valign: baseline;
                      styles ["weather-summary-icon"]
                      accessibility {
                        label: _("Temperature");
                        role-description: _("icon");
                      }
                    }

                    Label wx_temp {
                      label: _("48");
                      styles ["numeric"]
                    }

                    Separator {
                      orientation: vertical;
                      styles ["spot-badge-separator"]
                    }

                    Image {
                      icon-name: "drop-hollow-symbolic";
                      valign: baseline;
                      styles ["weather-summary-icon"]
                      accessibility {
                        label: _("Relative Humidity");
                        role-description: _("icon");
                      }
                    }

                    Label wx_humidity {
                      label: _("60%");
                      tooltip-text: _("Relative humidity");
                      styles ["numeric"]
                      }
                    }
                  }

                  Separator detail_shift_separator {
                    orientation: vertical;
                    visible: false;
                    styles ["spot-badge-separator"]
                  }

                  Box detail_shift_badge {
                    spacing: 4;
                    orientation: horizontal;
                    halign: end;
                    valign: center;
                    visible: false;

                    Image detail_shift_icon {
                      icon-name: "sunrise-outline-symbolic";
                      valign: baseline;
                      styles ["weather-summary-icon"]

                      accessibility {
                        label: _("Early/Late shift icon");
                      }
                    }

                    Label detail_shift_label {
                      label: _("Early Shift");
                    }
                  }
                }
                }
              }
          
            Revealer detail_buttons_revealer {
              transition-type: fade_slide_down;
              transition-duration: 250;

              Box {
                orientation: horizontal;
                spacing: 8;

                Button detail_not_heard_button {
                  tooltip-text: _("Mark this spot as not heard for 10 minutes");
                  styles ["circular", "spot-detail-icon-button"]
                  icon-name: "headphones-muted-symbolic";

                  accessibility {
                    label: _("Not Heard");
                    role-description: _("button");
                  }
                }

                Box {
                  hexpand: true;
                  styles ["linked"]

                  Button detail_tune_button {
                    label: _("Tune");
                    tooltip-text: _("Tune your radio to this frequency");
                    hexpand: true;
                    visible: false;
                    accessibility {
                      label: _("Tune");
                      role-description: _("button");
                    }
                  }

                  Button detail_spot_button {
                    label: _("Spot");
                    tooltip-text: _("Add your spot for this park");
                    hexpand: true;
                    visible: true;
                    styles ["suggested-action"]
                    accessibility {
                      label: _("Spot");
                      role-description: _("button");
                    }
                  }
                }

              }
            }

            Revealer open_map_revealer {
              transition-type: fade_slide_down;
              transition-duration: 250;

              Stack detail_map_slot_stack {
                transition-type: crossfade;
                transition-duration: 200;

                StackPage {
                  name: "open-map";
                  child: Button open_map_button {
                    Adw.ButtonContent {
                      icon-name: "map-symbolic";
                      label: _("Open Map");
                    }

                    accessibility {
                      label: _("Open map with the current spot");
                    }
                  };
                }

                StackPage {
                  name: "badges";
                  child: Box detail_map_badge_box {
                    orientation: horizontal;
                    spacing: 4;
                    halign: center;
                    valign: center;
                    visible: false;
                    styles ["spot-badge-drawer"]
                  };
                }
              }
            }

            Adw.PreferencesGroup detail_activator_group {
              title: _("Activator Profile");
              Gtk.ListBox detail_activator_list {
                selection-mode: none;
                styles ["boxed-list"]
              }
            }

            Adw.PreferencesGroup {
              title: _("Operating Details");
              Gtk.ListBox detail_operating_list {
                selection-mode: none;
                styles ["boxed-list"]
              }
            }

            Adw.PreferencesGroup {
              title: _("Location");
              Gtk.ListBox detail_location_list {
                selection-mode: none;
                styles ["boxed-list"]
              }
            }

            Adw.PreferencesGroup {
              title: _("Last Spot");
              Gtk.ListBox detail_last_spot_list {
                selection-mode: none;
                styles ["boxed-list"]
              }
            }

            Label {
              halign: center;
              justify: center;
              label: _("Weather data © OpenWeather");
              styles ["caption"]
            }
          }
        }
      };
    }
  }
}
