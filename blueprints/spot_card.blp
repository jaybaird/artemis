using Gtk 4.0;
using Adw 1;

template $SpotCard : Box {
  hexpand: true;
  halign: fill;
  valign: start;

  Box card_view {
    halign: fill;
    hexpand: true;
    orientation: vertical;

    spacing: 6;

    styles ["card", "frame"]

    Overlay {
      child: Box {
        margin-start: 10;
        margin-top: 10;
        margin-bottom: 6;
        margin-end: 10;
        orientation: horizontal;

        Adw.Avatar activator_avatar {
          valign: center;
          size: 32;
          margin-end: 6;
        }

        Box {
          orientation: vertical;
          valign: center;

          Label title {
            halign: start;
            justify: left;
            label: "K0VCZ @ K-1234";
            wrap-mode: word_char;
            styles ["title-2"]
          }

          Label park_label {
            halign: start;
            wrap: true;
            justify: left;
            wrap-mode: word_char;
          }
        }
      };

      [overlay]
      Image corner_image {
        tooltip-text: _("Hunted today");
        halign: end;
        valign: start;
        margin-end: 10;
        margin-top: 12;
        icon-name: "bullseye-symbolic";
        pixel-size: 16;
        visible: false;
      }
    }

    Separator {
      styles ["horizontal"]
    }

    Box {
      orientation: vertical;
      margin-start: 10;
      margin-end: 10;
      margin-bottom: 10;
      hexpand: false;
      spacing: 12;

      Box {
        orientation: horizontal;
        spacing: 10;
        tooltip-text: _("Location");

        Image {
          pixel-size: 20;
          icon-name: "map-marker-symbolic";
          valign: baseline;
        }

        Label location_desc {
          margin-bottom: 0;
          label: "US-WY";
          wrap: true;
          width-chars: 24;
          xalign: 0.0;
          ellipsize: end;
          wrap-mode: word;
        }
      }

      Box {
        orientation: horizontal;
        spacing: 10;
        tooltip-text: _("Frequency and mode");

        Box {
          orientation: horizontal;
          spacing: 10;
          
          Image {
            icon-name: "sound-wave-alt-symbolic";
            pixel-size: 20;
            valign: baseline;
          }

          Label frequency {
            halign: start;
            valign: baseline;
            label: "14074 kHz";
            styles ["numeric"]
          }
        }
        
        Box {
          orientation: horizontal;
          spacing: 10;
          
          Image {
            icon-name: "mode-symbolic";
            pixel-size: 20;
            valign: baseline;
          }
        
          Label mode {
            valign: baseline;
            label: "FT8";
          }
        }
      }

      Box {
        orientation: horizontal;
        spacing: 10;
        tooltip-text: _("Age");

        Image {
          pixel-size: 20;
          icon-name: "clocks-symbolic";
          valign: baseline;
        }

        Label time {
          halign: start;
          valign: baseline;
          label: "2 minutes ago";
        }
      }

    }

    Separator {
      styles ["horizontal"]
    }

    Box {
      orientation: horizontal;
      margin-start: 6;
      margin-end: 6;
      margin-top: 4;
      margin-bottom: 4;
      spacing: 6;
      homogeneous: true;

      Button tune_button {
        label: _("Tune");
        tooltip-text: _("Tune your radio to this frequency");
        hexpand: true;
        visible: false;
        styles ["raised"]
      }

      Button spot_button {
        label: _("Re-Spot");
        tooltip-text: _("Add your spot for this park");
        hexpand: true;
        styles ["raised", "suggested-action"]
      }
    }
  }
}
