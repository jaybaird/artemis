using Gtk 4.0;

template $StatusBar : Box {
  hexpand: true;
  halign: fill;

  styles ["view", "card"]

  CenterBox {
    hexpand: true;

    [start]
    Box {
      margin-start: 15;
      orientation: horizontal;
      valign: center;

      ToggleButton radio_power_button {
        styles ["radio-power-button"]
      }

      Box {
        margin-top: 5;
        margin-bottom: 5;

        Label radio_vfo {
          margin-top: 5;
          margin-bottom: 5;
          margin-start: 10;
          margin-end: 10;
          label: _("14.074.000");
          styles ["monospace"]
        }
      }

      Box {
        margin-top: 5;
        margin-bottom: 5;
        styles ["card"]

        Label radio_mode {
          margin-top: 5;
          margin-bottom: 5;
          margin-start: 10;
          margin-end: 10;
          label: _("USB-D");
          styles ["monospace"]
        }
      }
    }

    [center]
    Label status_bar_text {
      halign: center;
      justify: center;
      xalign: 0.5;
      label: _("64 spots. (4 filtered)");
    }

    [end]
    Box {
      spacing: 15;
      orientation: horizontal;
      valign: center;
      halign: end;
      margin-end: 15;

      ProgressBar refresh_progress {
        valign: center;
      }

      Label current_time {
        tooltip-text: _("Current Time (UTC)");
        styles ["utc-time", "monospace"]
        label: "18:51:27 UTC";
      }

      ToggleButton refresh_button {
        width-request: 30;
        height-request: 30;
        icon-name: "media-playback-pause-symbolic";
        styles ["circular"]
      }
    }
  }
}
