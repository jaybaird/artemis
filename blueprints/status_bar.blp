using Gtk 4.0;
using Adw 1;

template $StatusBar : Box {
  halign: fill;
  hexpand: true;

  styles ["toolbar"]

  CenterBox {
    margin-bottom: 4;
    margin-top: 4;
    margin-start: 6;
    margin-end: 6;
    hexpand: true;

    [start]
    Label status_bar_text {
      halign: start;
      hexpand: true;
      justify: left;
      xalign: 0.0;
      ellipsize: end;
      max-width-chars: 24;
      label: _("64 spots. (4 filtered)");
    }

    [center]
    Box {
      orientation: horizontal;
      spacing: 6;
      halign: center;

      Label refresh_status {
        halign: center;
        hexpand: false;
        justify: center;
        xalign: 0.5;
        ellipsize: end;
        max-width-chars: 16;
        label: _("Refreshes in 120s");
        styles ["numeric"]
      }

      Adw.SplitButton notification_button {
        icon-name: "logs-symbolic";
        can-shrink: true;
        direction: up;
        dropdown-tooltip: _("Recent Messages");
        tooltip-text: _("Recent Messages");
        styles ["flat"]

        popover: Popover notification_popover {
          has-arrow: true;

          Box {
            orientation: vertical;
            spacing: 8;
            width-request: 320;
            margin-top: 10;
            margin-bottom: 10;
            margin-start: 10;
            margin-end: 10;

            Box {
              orientation: horizontal;
              spacing: 6;

              Label {
                label: _("Recent Messages");
                xalign: 0.0;
                hexpand: true;
                styles ["heading"]
              }

              Button clear_notifications_button {
                icon-name: "edit-clear-symbolic";
                tooltip-text: _("Clear Messages");
                styles ["flat"]
                accessibility {
                  label: _("Clear Messages");
                  role-description: _("button");
                }
              }
            }

            Label notification_empty_label {
              label: _("No recent messages");
              xalign: 0.0;
              margin-top: 6;
              margin-bottom: 6;
              styles ["dim-label"]
            }

            ScrolledWindow {
              min-content-width: 300;
              max-content-height: 280;
              propagate-natural-height: true;

              child: ListBox notification_list {
                selection-mode: none;
                styles ["boxed-list"]
              };
            }
          }
        };

        accessibility {
          label: _("Recent Messages");
          role-description: _("button");
        }
      }
    }

    [end]
    Label current_time {
      tooltip-text: _("Current Time (UTC)");
      hexpand: false;
      ellipsize: end;
      max-width-chars: 12;
      styles ["utc-time", "numeric"]
      label: _("18:51:27 UTC");
    }
  }
}
