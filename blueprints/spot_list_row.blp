using Gtk 4.0;

template $SpotListRow : Box {
  orientation: horizontal;
  spacing: 12;
  margin-top: 6;
  margin-bottom: 6;
  margin-start: 8;
  margin-end: 12;

  Box {
    orientation: horizontal;
    spacing: 4;
    valign: center;

    Button spot_button {
      icon-name: "bullseye-symbolic";
      tooltip-text: _("Add your spot for this park");
      valign: center;
      visible: false;
      styles ["suggested-action", "spot-list-icon-button"]
    }

    Button tune_button {
      icon-name: "encoder-knob-symbolic";
      tooltip-text: _("Tune your radio to this frequency");
      valign: center;
      visible: false;
      styles ["flat", "spot-list-icon-button"]
    }

    Button not_heard_button {
      icon-name: "headphones-muted-symbolic";
      tooltip-text: _("Mark this spot as not heard for 10 minutes");
      valign: center;
      visible: false;
      styles ["flat", "spot-list-icon-button"]
    }
  }

  $BandStrip band_marker {
    valign: center;
    margin-end: 4;
    styles ["band-strip-list"]
  }

  Box {
    orientation: vertical;
    spacing: 2;
    hexpand: true;
    valign: center;

    Label callsign_label {
      hexpand: true;
      xalign: 0.0;
      ellipsize: end;
      styles ["heading"]
    }

    Label park_label {
      hexpand: true;
      xalign: 0.0;
      ellipsize: end;
      styles ["dim-label"]
    }
  }

  Box {
    orientation: horizontal;
    spacing: 12;
    halign: end;
    valign: center;
    hexpand: false;

    Label location_label {
      xalign: 1.0;
      justify: right;
      ellipsize: end;
      width-chars: 8;
      max-width-chars: 12;
      styles ["dim-label"]
    }

    Label frequency_label {
      xalign: 1.0;
      styles ["numeric"]
    }

    Label mode_label {
      xalign: 0.5;
      styles ["pill", "caption"]
    }

    Box badge_box {
      orientation: horizontal;
      spacing: 4;
      valign: center;
      styles ["spot-badge-drawer"]
    }

    Label time_label {
      xalign: 1.0;
      styles ["dim-label"]
    }

  }
}
