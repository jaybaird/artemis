outs = [
  'add_spot_page.ui',
  'avatar_detail_dialog.ui',
  'alerts_window.ui',
  'first_run_setup_dialog.ui',
  'main_window.ui',
  'help_window.ui',
  'preferences_general_page.ui',
  'preferences_map_page.ui',
  'preferences_radio_page.ui',
  'preferences_logging_page.ui',
  'preferences_wsjtx_page.ui',
  'preferences.ui',
  'spot_card.ui',
  'spot_history_dialog.ui',
  'spot_history_row.ui',
  'spot_page.ui',
  'spot_list_view.ui',
  'spot_list_row.ui',
  'band_view.ui',
  'status_bar.ui',
  'notification_row.ui',
  'park_log_dialog.ui',
  'park_log_message_row.ui',
  'park_log_qso_row.ui',
  'left_sidebar.ui',
  'logbook_window.ui',
  'qso_dialog.ui',
  'spot_detail.ui',
  'space_weather_popover.ui',
  'detail_field_row.ui',
  'detail_link_row.ui',
  'detail_time_pair_row.ui',
  'help_article_row.ui',
  'help_section_header_row.ui',
  'help_spot_badge_row.ui',
  'band_button.ui',
  'map_marker_popover.ui'
]

blueprint_batch = custom_target(
  'blueprints compile',
  input: inputs,
  output: outs,
  command: [
    find_program('blueprint-compiler', required: true), 'batch-compile',
    '@CURRENT_SOURCE_DIR@/../data/ui',
    '@CURRENT_SOURCE_DIR@',
    '@INPUT@'
  ],
  build_by_default: true,
  install: false,
)
