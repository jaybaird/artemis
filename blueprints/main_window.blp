using Gtk 4.0;
using Adw 1;

template $AppWindow : Adw.ApplicationWindow {
  title: _("Trailwave");
  default-width: 1280;
  default-height: 720;
  width-request: 360;
  height-request: 480;

  Adw.OverlaySplitView sidebar_split {
    collapsed: false;
    show-sidebar: true;
    enable-show-gesture: true;
    enable-hide-gesture: true;
    min-sidebar-width: 220;
    max-sidebar-width: 260;
    sidebar-width-fraction: 0.2;
    sidebar-width-unit: sp;
    sidebar-position: start;
    
    [sidebar]
    $LeftSidebar left_sidebar {
      width-request: 220;
      hexpand: false;
    }

    [content]
    Adw.OverlaySplitView inspector_split {
      enable-show-gesture: true;
      enable-hide-gesture: true;
      min-sidebar-width: 320;
      max-sidebar-width: 400;
      sidebar-position: end;

      [content] 
      Adw.BreakpointBin {
        width-request: 360;
        height-request: 480;

        Adw.Breakpoint {
          condition ("max-width: 550sp")
          setters {
            switcher_bar.reveal: true;
            main_header.title-widget: null;
          }
        }

        child: Adw.ToolbarView {
          extend-content-to-top-edge: true;

          [top]
          Adw.HeaderBar main_header {
            show-start-title-buttons: true;
            show-end-title-buttons: true;

            title-widget: Adw.ViewSwitcher {
              halign: center;
              stack: views;
              policy: wide;
            };

            [start]
            Box {
              orientation: horizontal;
              spacing: 4;

              Adw.Clamp collapsed_sidebar_controls {
                maximum-size: 96;
                visible: false;

                Box {
                  orientation: horizontal;
                  spacing: 4;

                  Button header_add_spot_button {
                    icon-name: "list-add-symbolic";
                    tooltip-text: _("Add Spot");
                    accessibility {
                      label: _("Add Spot");
                      role-description: _("button");
                    }
                  }

                  ToggleButton sidebar_toggle {
                    icon-name: "sidebar-show-symbolic";
                    tooltip-text: _("Hide Sidebar");
                    active: true;
                    accessibility {
                      label: _("Show Sidebar");
                      role-description: _("toggle button");
                    }
                  }
                }
              }

              Stack refresh_button_stack {
                transition-type: crossfade;
                transition-duration: 250;
                visible-child-name: "refresh_spinner";
                
                Adw.Spinner refresh_spinner {
                  width-request: 24;
                  height-request: 24;

                  accessibility {
                    label: _("Loading");
                  }
                }
              
                ToggleButton refresh_toggle {
                  icon-name: "media-playback-pause-symbolic";
                  tooltip-text: _("Pause");
                  accessibility {
                    label: _("Pause Updates");
                    role-description: _("toggle button");
                  }
                }
              }
            }

            [end]
            Box {
              orientation: horizontal;
              spacing: 4;

              ToggleButton search_button {
                icon-name: "edit-find-symbolic";
                tooltip-text: _("Search");
                accessibility {
                  label: _("Search");
                  role-description: _("toggle button");
                }
              }

              MenuButton space_weather_menu_button {
                tooltip-text: _("Solar Conditions");
                styles ["image-button", "flat"]

                child: $SpaceWeatherButton space_weather_button {};

                accessibility {
                  label: _("Solar Conditions");
                  role-description: _("menu button");
                }
              }

              Button {
                tooltip-text: _("Alerts");
                action-name: "app.alerts";
                styles ["image-button", "flat"]

                Overlay {
                  Image {
                    icon-name: "preferences-system-notifications-symbolic";
                  }

                  [overlay]
                  Box alerts_badge {
                    width-request: 8;
                    height-request: 8;
                    halign: end;
                    valign: start;
                    visible: false;
                    styles ["toolbar-status-badge", "enabled"]
                    accessibility {
                      label: _("Spot Alerts Enabled");
                      role-description: _("status indicator");
                    }
                  }
                }

                accessibility {
                  label: _("Alerts");
                  role-description: _("button");
                }
              }

              ToggleButton inspector_toggle {
                icon-name: "dock-right-symbolic";
                tooltip-text: _("Show Inspector");
                active: true;
                accessibility {
                  label: _("Show Inspector");
                  role-description: _("toggle button");
                }
              }

              MenuButton button_menu {
                menu-model: menu_app;
                icon-name: "open-menu-symbolic";
                accessibility {
                  label: _("Application Menu");
                  role-description: _("menu button");
                }
              }
            }
          }

          [top]
          Adw.Bin {
            margin-start: 16;
            margin-end: 16;
            styles ["overlay-search-bar"]

            SearchBar search_bar {
              SearchEntry search_entry {
                hexpand: true;
                input-hints: no_spellcheck;
                placeholder-text: _("Search for Park or Callsign");
                styles ["overlay-search-entry"]
                accessibility {
                  label: _("Search for Park or Callsign");
                  role-description: _("search entry");
                }
              }
            }
          }
     
          content: Adw.ToastOverlay toast_overlay {

            Adw.ViewStack views {
              Adw.ViewStackPage {
                name: "cards";
                title: _("Cards");
                icon-name: "grid-filled-symbolic";

                child: $BandView band_view {
                  hexpand: true;
                  vexpand: true;
                  margin-top: 48;
                  margin-start: 12;
                  margin-end: 12;
                };
              }

              Adw.ViewStackPage {
                name: "list";
                title: _("List");
                icon-name: "view-list-symbolic";

                child: Box list_container {
                  hexpand: true;
                  vexpand: true;
                  margin-top: 48;
                  margin-start: 12;
                  margin-end: 12;
                };
              }

              Adw.ViewStackPage {
                name: "map";
                title: _("Map");
                icon-name: "map-symbolic";

                child: Box map_container {
                  hexpand: true;
                  vexpand: true;
                };
              }
            }
          };

          [bottom]
          $StatusBar status_bar {
            hexpand: true;
            margin-top: 0;
            margin-bottom: 0;
          }

          [bottom]
          Adw.ViewSwitcherBar switcher_bar {
            stack: views;
            reveal: false;
          }
        };
      }

      [sidebar]
      $SpotDetail spot_detail {
          width-request: 360;
          hexpand: false;
      }
    }
  }
}

menu menu_app {
  section {
    item {
      label: _("Add Spot");
        action: "app.add-spot";
      }

    item {
      label: _("Refresh");
      action: "app.refresh";
    }

    item {
      label: _("Tune");
      action: "app.tune";
    }

    item {
      label: _("Logbook");
      action: "app.logbook";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Alerts");
      icon-name: "preferences-system-notifications-symbolic";
      action: "app.alerts";
    }

  }

  section {
    item {
      label: _("Help");
      action: "app.help";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("Preferences");
      action: "app.preferences";
    }


    item {
      label: _("About Trailwave");
      action: "app.about";
    }
  }
}
