using Gtk 4.0;
using Adw 1;

StringList signal_report_spread_model {
  strings [
    _("Compact"),
    _("Normal"),
    _("Wide"),
  ]
}

template $MapPreferencesPage : Adw.PreferencesPage {
  title: _("Map");
  icon-name: "map-symbolic";

  Adw.PreferencesGroup {
    title: _("Signal Reports");

    Adw.SpinRow row_signal_report_max_age {
      title: _("Maximum Age");
      subtitle: _("How long signal reports remain visible on the heatmap, in minutes");
      digits: 0;
      climb-rate: 5.0;
      accessibility {
        label: _("Maximum Age");
        role-description: _("spin button");
      }
      adjustment: Adjustment {
        step-increment: 5;
        lower: 5;
        upper: 120;
        value: 30;
      };
    }

    Adw.ComboRow row_signal_report_spread {
      title: _("Heatmap Spread");
      subtitle: _("How wide each report appears in the signal report overlay");
      model: signal_report_spread_model;
      accessibility {
        label: _("Heatmap Spread");
        role-description: _("combo box");
      }
    }

    Adw.SwitchRow row_signal_report_preload_history {
      title: _("Preload Recent Reports");
      subtitle: _("Load recent PSKReporter reports before starting the live stream");
      accessibility {
        label: _("Preload Recent Reports");
        role-description: _("switch");
      }
    }
  }
}
