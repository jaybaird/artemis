using Gtk 4.0;
using Adw 1;

TextBuffer keyword_buffer {
}

template $AlertsWindow : Adw.Window {
  title: _("Alerts");
  default-width: 520;
  default-height: 460;
  width-request: 360;
  height-request: 360;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: _("Alerts");
      };
    }

    content: Adw.PreferencesPage {
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;

      Adw.PreferencesGroup {
        title: _("Spot Alerts");
        description: _("Keywords match callsign, park reference or name, location, grid, band, mode, activator comments, or spotter comments.");

        Adw.SwitchRow enabled_row {
          title: _("Enable Spot Alerts");
          subtitle: _("Show desktop notifications when matching spots appear.");
          accessibility {
            label: _("Enable Spot Alerts");
            role-description: _("switch");
          }
        }

        Adw.PreferencesRow {
          title: _("Keywords");

          Box {
            orientation: vertical;
            spacing: 6;
            margin-top: 12;
            margin-bottom: 12;
            margin-start: 12;
            margin-end: 12;

            Label {
              label: _("Keywords");
              xalign: 0;
              styles ["heading"]
            }

            ScrolledWindow {
              height-request: 180;
              hscrollbar-policy: never;
              vscrollbar-policy: automatic;
              styles ["card"]

              TextView keyword_view {
                accepts-tab: false;
                bottom-margin: 8;
                buffer: keyword_buffer;
                hexpand: true;
                input-hints: no_spellcheck;
                top-margin: 8;
                vexpand: true;
                wrap-mode: word_char;
                accessibility {
                  label: _("Keywords");
                  role-description: _("text view");
                }
              }
            }

            Label {
              label: _("Enter one keyword rule per line.");
              xalign: 0;
              wrap: true;
              styles ["dim-label"]
            }
          }
        }
      }
    };
  }
}
