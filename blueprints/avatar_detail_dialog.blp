using Gtk 4.0;
using Adw 1;

template $AvatarDetailDialog : Adw.Dialog {
  content-width: 600;
  content-height: 500;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle title_widget {
        title: _("Avatar Detail");
      };
    }

    content: Adw.Bin {
      Adw.Avatar avatar_image {
        size: 256;
        text: _("");
      }
    };
  }
}