using Gtk 4.0;
using Adw 1;

template $SpaceWeatherPopover : Popover {
  has-arrow: true;

  Box {
    orientation: vertical;
    spacing: 10;
    margin-top: 12;
    margin-bottom: 0;
    margin-start: 12;
    margin-end: 12;
    width-request: 260;

    Box {
      orientation: horizontal;
      spacing: 12;

      Overlay hero_overlay {
        styles ["space-weather-hero"]

        Image {
          icon-name: "sun-outline-symbolic";
        }

        [overlay]
        Label hero_kp_label {
          label: "—";
          halign: center;
          valign: center;
          styles ["space-weather-hero-kp"]
        }
      }

      Box {
        orientation: vertical;
        spacing: 3;
        valign: center;

        Box {
          orientation: horizontal;
          spacing: 8;

          Label title_label {
            label: _("Solar Conditions");
            xalign: 0.0;
            styles ["title-4"]
          }

          Adw.Bin storm_scale_badge {
            visible: false;
            valign: center;
            styles ["space-weather-storm-scale"]

            Label storm_scale_label {
              label: "";
              styles ["space-weather-storm-scale-label"]
            }
          }
        }

        Label updated_label {
          label: _("");
          xalign: 0.0;
          wrap: true;
          styles ["caption", "dim-label"]
        }
      }
    }

    Box {
      orientation: vertical;
      spacing: 6;
      styles ["space-weather-metrics"]

      Box {
        orientation: horizontal;
        spacing: 12;

        Label {
          label: _("Kp Trend");
          xalign: 0.0;
          hexpand: true;
          styles ["dim-label"]
        }

        Label {
          label: _("Last 24h");
          xalign: 1.0;
          styles ["caption", "dim-label"]
        }
      }

      DrawingArea kp_scale_area {
        content-width: 220;
        content-height: 38;
        hexpand: true;
        styles ["space-weather-kp-scale"]
      }
    }

    Box {
      orientation: vertical;
      spacing: 6;
      styles ["space-weather-metrics"]

      Box {
        orientation: horizontal;
        spacing: 12;

        Label {
          label: _("Solar Flux");
          xalign: 0.0;
          hexpand: true;
          styles ["dim-label"]
        }

        Label sfi_value_label {
          label: "—";
          xalign: 1.0;
          styles ["numeric"]
        }
      }

      Box {
        orientation: horizontal;
        spacing: 12;

        Label {
          label: _("Sunspots");
          xalign: 0.0;
          hexpand: true;
          styles ["dim-label"]
        }

        Label ssn_value_label {
          label: "—";
          xalign: 1.0;
          styles ["numeric"]
        }
      }

      Box {
        orientation: horizontal;
        spacing: 12;

        Label {
          label: _("A-Index");
          xalign: 0.0;
          hexpand: true;
          styles ["dim-label"]
        }

        Label a_index_value_label {
          label: "—";
          xalign: 1.0;
          styles ["numeric"]
        }
      }

      Box {
        orientation: horizontal;
        spacing: 12;

        Label {
          label: _("X-Ray Flux");
          xalign: 0.0;
          hexpand: true;
          styles ["dim-label"]
        }

        Label xray_flux_value_label {
          label: "—";
          xalign: 1.0;
          styles ["numeric"]
        }
      }

      Box {
        orientation: horizontal;
        spacing: 12;

        Label {
          label: _("Solar Wind");
          xalign: 0.0;
          hexpand: true;
          styles ["dim-label"]
        }

        Label solar_wind_value_label {
          label: "—";
          xalign: 1.0;
          styles ["numeric"]
        }
      }
    }

    LinkButton source_link_button {
      margin-bottom: 0;
      margin-start: 0;
      margin-end: 0;
      margin-top: 0;
      uri: "https://swpc.noaa.gov";
      label: _("Sources: NOAA SWPC, SILSO");
      halign: end;
      styles ["flat", "caption", "dim-label"]
    }
  }
}
