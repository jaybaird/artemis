{
    "id": "com.k0vcz.Artemis",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "com.k0vcz.Artemis",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=all",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/girepository-1.0",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/gir-1.0",
        "/share/man",
        "/share/vala",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "hamlib",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-static",
                "--without-cxx-binding",
                "--disable-winradio",
                "--without-indi",
                "--without-readline"
            ],
            "cleanup": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/Hamlib/Hamlib/releases/download/4.7.1/hamlib-4.7.1.tar.gz",
                    "sha256": "d197a08a3d5d936d7571ae573f745bbba619e88998742c8267e3fcb0fb3d5974"
                }
            ]
        },
        {
            "name": "protobuf",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
                "-Dprotobuf_ABSL_PROVIDER=package",
                "-Dprotobuf_BUILD_SHARED_LIBS=ON",
                "-Dprotobuf_BUILD_TESTS=OFF"
            ],
            "cleanup": [
                "/bin/protoc*",
                "/lib/libprotoc*"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/protocolbuffers/protobuf.git",
                    "tag": "v32.1",
                    "commit": "7fcfd66022455635fa29af92987cdc0967efd4f3"
                }
            ]
        },
        {
            "name": "protobuf-c",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/protobuf-c/protobuf-c.git",
                    "tag": "v1.5.2",
                    "commit": "4719fdd7760624388c2c5b9d6759eb6a47490626"
                }
            ]
        },
        {
            "name": "shumate",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/GNOME/libshumate.git",
                    "tag": "1.6.1",
                    "commit": "8bf191245f8010b003b6bb5462201cb35d61ecbb"
                }
            ]
        },
        {
            "name": "paho-mqtt-c",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DPAHO_BUILD_SHARED=TRUE",
                "-DPAHO_BUILD_STATIC=FALSE",
                "-DPAHO_BUILD_SAMPLES=FALSE",
                "-DPAHO_WITH_SSL=FALSE"
            ],
            "cleanup": [
                "/bin"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/eclipse-paho/paho.mqtt.c.git",
                    "tag": "v1.3.16",
                    "commit": "4a939ddb01eea581a32fd6f0adcfee51b91d2601"
                }
            ]
        },
        {
            "name" : "artemis",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts":[
                "-Dbuildtype=release",
                "-Dmapbox_access_token=pk.eyJ1IjoiazB2Y3oiLCJhIjoiY21wamNnbHpkMTJpdzJwcHNoOXBvbzZiNSJ9.PBpJW9GbX82C2uQNrn0Asg",
                "-Dopenweather_api_key=79d09752976d3a97926412f49b93cd11"
            ],
            "build-commands": [
                "chmod +x subprojects/blueprint-compiler/blueprint-compiler || true"
            ],
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "."
                }
            ]
        }
    ]
}
