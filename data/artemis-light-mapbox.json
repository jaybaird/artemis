{
  "version": 8,
  "name": "Artemis Raster Simple",
  "sources": {
    "mapbox-streets": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    }
  },
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sprite": "mapbox://sprites/mapbox/light-v11",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eef3ea"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "mapbox-streets",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9fc4d4"
      }
    },
    {
      "id": "parks-national",
      "type": "fill",
      "source": "mapbox-streets",
      "source-layer": "landuse_overlay",
      "filter": ["==", ["get", "class"], "national_park"],
      "paint": {
        "fill-color": "#8fbf7a",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "parks-general",
      "type": "fill",
      "source": "mapbox-streets",
      "source-layer": "landuse_overlay",
      "filter": ["==", ["get", "class"], "park"],
      "paint": {
        "fill-color": "#b8d8a8",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", ["get", "class"], ["literal", ["street", "secondary", "tertiary"]]],
      "paint": {
        "line-color": "#d6c7a1",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.5,
          10, 1.5,
          14, 3
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "mapbox-streets",
      "source-layer": "road",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]],
      "paint": {
        "line-color": "#c79c62",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.8,
          10, 2,
          14, 4
        ]
      }
    },
    {
      "id": "state-labels",
      "type": "symbol",
      "source": "mapbox-streets",
      "source-layer": "place_label",
      "filter": ["==", ["get", "class"], "state"],
      "layout": {
        "text-field": ["coalesce", ["get", "abbr"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3, 10,
          6, 14
        ]
      },
      "paint": {
        "text-color": "#4a5a48",
        "text-halo-color": "#eef3ea",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "park-pois",
      "type": "symbol",
      "source": "mapbox-streets",
      "source-layer": "poi_label",
      "filter": [
        "in",
        ["get", "maki"],
        ["literal", ["campsite", "attraction", "picnic-site", "park"]]
      ],
      "layout": {
        "icon-image": ["get", "maki"],
        "icon-size": 0.9,
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": 11,
        "text-offset": [0, 1.1],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#2f4f2f",
        "text-halo-color": "#eef3ea",
        "text-halo-width": 1
      }
    }
  ]
}