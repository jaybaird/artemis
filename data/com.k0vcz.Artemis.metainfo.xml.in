  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#1f5ab4</color>
    <color type="primary" scheme_preference="dark">#545454</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image type="source">https://raw.githubusercontent.com/jaybaird/artemis-vala/main/screenshots/cards-light.png</image>
      <caption>Light theme cards view showing live POTA spots, sidebar filters, radio controls, and the spot detail inspector.</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/jaybaird/artemis-vala/main/screenshots/cards-dark.png</image>
      <caption>Dark theme cards view showing spot cards with band colors, activity badges, and quick tune and re-spot actions.</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/jaybaird/artemis-vala/main/screenshots/list-light.png</image>
      <caption>Light theme list view showing current spots in a compact table-style layout with frequency, mode, location, and activity details.</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/jaybaird/artemis-vala/main/screenshots/list-dark.png</image>
      <caption>Dark theme list view showing filtered POTA spots with direct row actions for tuning and re-spotting.</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/jaybaird/artemis-vala/main/screenshots/map-light.png</image>
      <caption>Light theme map view showing park activity markers, the sidebar filters, and the selected spot inspector.</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/jaybaird/artemis-vala/main/screenshots/map-dark.png</image>
      <caption>Dark theme map view showing active parks on an interactive map with the floating refresh status bar.</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="2.0.1" date="2026-05-15">
      <url type="details">https://github.com/jaybaird/artemis-vala/releases/tag/v2.0.1</url>
      <description>
        <p>Fixes the following bugs:</p>
        <ul>
          <li>Mode and program filters would be reset on every refresh</li>
          <li>Frequencies with sub-kHz would be truncated</li>
        </ul>
      </description>
    </release>
    <release version="2.0" date="2026-05-15">
      <url type="details">https://github.com/jaybaird/artemis-vala/releases/tag/v2.0</url>
      <description>
        <p>Redesigned the main hunting workflow with a dedicated left sidebar, cleaner spot cards, a full list view, an improved map view, and a richer spot detail inspector.</p>
        <ul>
          <li>Moved band, mode, and program filters into the sidebar, with mode and program choices now based on the currently available spots.</li>
          <li>Added spot weather, and badges for hunted/new activity</li>
          <li>Added list-view operation with direct tune and re-spot buttons on each row.</li>
          <li>Added FT4 support in Add Spot and Re-Spot flows, and fixed a bug preserving fractional kHz frequencies.</li>
          <li>Improved map behavior so user panning is respected during refreshes and repeated spot selection updates.</li>
          <li>Improved POTA, QRZ, weather, and radio-control reliability, including safer response parsing, better refresh coalescing, and more robust Hamlib integration.</li>
        </ul>
      </description>
    </release>
    <release version="1.2" date="2026-03-19">
      <url type="details">https://github.com/jaybaird/artemis/releases/tag/v1.2</url>
      <description>
        <p>Fixed a bug where logging to QRZ was not working</p>
        <p>Fixed a bug in hamlib where stop and parity bits were not being passed correctly</p>
      </description>
    </release>
    <release version="1.1" date="2026-02-25">
      <url type="details">https://github.com/jaybaird/artemis-vala/releases/tag/v1.1</url>
      <description>
        <p>Added much better hamlib support for radios and features</p>
        <p>Fixed a map bug where unconfigured QTH grid square would cause map to just not work</p>
        <p>Added support for Windows</p>
        <p>Lots of other small bug fixes across the app</p>
      </description>
    </release>
    <release version="1.0.2" date="2026-02-25">
      <url type="details">https://github.com/jaybaird/artemis-vala/releases/tag/v1.0.2</url>
      <description>
        <p>Changed flatpak permissions to device=all so that serial ports can work without an override.</p>
      </description>
    </release>
    <release version="1.0.1" date="2026-02-24">
      <url type="details">https://github.com/jaybaird/artemis-vala/releases/tag/v1.0.1</url>
      <description>
        <p>Fixed a crash when submitting a new spot. Avatar cache updates are now more responsive, and a bug that could
         cause high CPU usage after disconnecting a radio has been fixed. Full changelog
         below:</p>
        <ul>
          <li>Fixed a crash and multiple SQL errors when submitting/re-spotting a park.</li>
          <li>Added null checks to lat/long parsing and grid handling.</li>
          <li>Fixed radio status watcher loop behavior.</li>
          <li>Fixed multiple memory leaks.</li>
          <li>Removed duplicate <code>radio_status</code> signal handlers on reconnect.</li>
          <li>Fixed radio UI state getting out of sync.</li>
          <li>Fixed Tune button behavior on spot cards so it no longer disappears.</li>
          <li>Fixed inconsistent “All” filter handling (<code>_("All")</code> vs <code>"All"</code>).</li>
          <li>Fixed avatar updates lagging until a second sync.</li>
          <li>Improved avatar update efficiency so spot cards update only the affected avatar/tooltip from cache instead of re-fetching/reprocessing both callsigns.</li>
          <li>Fixed a spot-card signal teardown warning.</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-02-14">
      <url type="details">https://github.com/jaybaird/artemis-vala/releases/tag/v1.0.0</url>
      <description translate="no">
        <p>Initial public release of Artemis.</p>
        <ul>
          <li>Live POTA spot filtering by band, mode, and program</li>
          <li>Integrated map view for park and spot visualization</li>
          <li>Radio CAT integration with Hamlib for tune and mode control</li>
          <li>CSV-based hunter history import and local activity tracking</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
