<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.k0vcz.Artemis</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Artemis</name>
  <summary>Hunt Parks on the Air</summary>
  <description>
    <p>Artemis helps amateur radio operators hunt Parks on the Air activations with a fast desktop workflow for filtering spots, spotting, and tuning radios with one-click QSY.</p>
    <p>Use live spot filtering by band, mode, and program, view parks on an interactive map, and coordinate your station with integrated CAT control through Hamlib.</p>
  </description>

  <developer id="tld.vendor">
    <name>Jay Baird (K0VCZ)</name>
  </developer>

  <!-- Required: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://github.com/jaybaird/artemis-vala</url>
  <!-- Recommended: It is highly recommended for open-source projects to display the source code repository -->
  <url type="vcs-browser">https://github.com/jaybaird/artemis-vala</url>
  <!-- Should point to the software's bug tracking system, for users to report new bugs -->
  <url type="bugtracker">https://github.com/jaybaird/artemis-vala/issues</url>
  <!-- Should link a FAQ page for this software, to answer some of the most-asked questions in detail -->
  <!-- URLs of this type should point to a webpage where users can submit or modify translations of the upstream project -->
  <url type="translate">https://github.com/jaybaird/artemis-vala</url>
  <url type="faq">https://github.com/jaybaird/artemis-vala#readme</url>
  <!-- Should provide a web link to an online user's reference, a software manual or help page -->
  <url type="help">https://github.com/jaybaird/artemis-vala#readme</url>
  <!-- URLs of this type should point to a webpage showing information on how to donate to the described software project -->
  <url type="donation">https://github.com/jaybaird/artemis-vala</url>
  <!-- This could for example be an HTTPS URL to an online form or a page describing how to contact the developer -->
  <url type="contact">https://github.com/jaybaird/artemis-vala/issues</url>
  <!-- URLs of this type should point to a webpage showing information on how to contribute to the described software project -->
  <url type="contribute">https://github.com/jaybaird/artemis-vala/pulls</url>

  <translation type="gettext">com.k0vcz.Artemis</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">com.k0vcz.Artemis.desktop</launchable>
